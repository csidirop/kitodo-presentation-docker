# -- This is a template file! Copy and rename it to .env and change your credentials! -- #
# -- MariaDB -- #
MARIADB_ROOT_PASSWORD='rootpassword' # MariaDB root password
MARIADB_USER=typo3 # MariaDB username
MARIADB_PASSWORD='password' # MariaDB user password
# -- TYPO3 -- #
PORT=80 # Local port for TYPO3
TYPO3_ADMIN_USER=test # TYPO3 admin username
TYPO3_ADMIN_PASSWORD='Test1234!' # TYPO3 admin password in ''
TYPO3_ADDITIONAL_CONFIGURATION=false # Set to true if you want to add additional configuration
PQDN=localhost # Partially qualified domain name (Fully-Qualified Host Name (FQHN) without dot at the end)
PHP_MEMORY_LIMIT="512M" # PHP memory limit
# -- Keycloak / OpenID Connect (development defaults; change secrets outside local development) -- #
KEYCLOAK_PORT=8081
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD='admin'
OIDC_REALM=kitodo
OIDC_CLIENT_ID=kitodo-presentation
OIDC_CLIENT_SECRET='kitodo-presentation-secret-change-me'
OIDC_REQUIRED_ROLE=image-reader
OIDC_BROWSER_BASE_URL=http://localhost:8081
OIDC_INTERNAL_BASE_URL=http://keycloak:8080
OIDC_REDIRECT_URI=http://localhost/
OIDC_WEB_ORIGIN=http://localhost
